# TECHNOVA Backend — Environment Variables

# Application
APP_NAME=TECHNOVA
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://technova:technova@localhost:5432/technova
DATABASE_ECHO=false

# Security
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# MongoDB (future)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB_NAME=technova

# Redis (future)
# REDIS_URL=redis://localhost:6379

# Object Storage (future)
# STORAGE_BUCKET=technova-storage
